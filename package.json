{
  "name": "saa-process",
  "version": "0.1.0",
  "private": true,
  "description": "SAA Process Endorsement & Meancheck web app (client + server + database)",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run db:up && concurrently -k -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:up": "docker compose --env-file .env -f database/docker-compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f database/docker-compose.yml down",
    "db:logs": "docker compose --env-file .env -f database/docker-compose.yml logs -f postgres",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "db:reset": "npm run db:down && rimraf database/data && npm run db:up && npm run db:migrate && npm run db:seed",
    "extract": "python database/extract/run_all.py --src \"D:/Workstation/evalice/docs\" --out database/seed",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:build": "npm run build && npm run tunnel"
  },
  "devDependencies": {
    "cloudflared": "0.7.3",
    "concurrently": "10.0.5",
    "oxlint": "1.85.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  }
}
