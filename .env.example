# ---- PostgreSQL (docker compose) ----
POSTGRES_USER=saa
POSTGRES_PASSWORD=saa
POSTGRES_DB=saa
POSTGRES_PORT=5432

# ---- Server ----
DATABASE_URL=postgres://saa:saa@localhost:5432/saa
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
TZ=Asia/Manila
LOG_LEVEL=info

# ---- Client (dev only) ----
VITE_API_PROXY_TARGET=http://localhost:3000
